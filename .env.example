# Neon pooled connection string for application runtime.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DBNAME?sslmode=require&channel_binding=require"
# Neon direct connection string for Prisma schema changes and migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require&channel_binding=require"
# Generate a unique value with at least 32 random bytes for each environment.
AUTH_SECRET=""
